# Local stdio preset:
# Uncomment and fill these only when you run the server locally in `stdio` mode.
# HUAWEICLOUD_REGION=cn-north-4
# HUAWEICLOUD_AK=your-ak
# HUAWEICLOUD_SK=your-sk
#
# Usage modes:
# - local stdio: uncomment and fill the HUAWEICLOUD_* variables above
# - shared HTTP multi-user: leave the HUAWEICLOUD_* values empty and let each user call
#   `auth_configure_session` with their own AK/SK after connecting
# - shared HTTP single-account: fill HUAWEICLOUD_* plus MCP_AUTH_STATIC_TOKEN below
#
#
# Standard setup:
# - for both `stdio` and shared `http + session` mode, standard regions only need:
#   - access_key
#   - secret_key
#   - region
# - the server resolves the standard CodeArts product URLs from `region`
# - only uncomment the product/base URL overrides below if your tenant really uses non-standard routes
#
# Optional generic console override:
# HUAWEICLOUD_BASE_URL=https://codearts.cn-north-4.myhuaweicloud.com
#
# Optional product base URL overrides:
# HUAWEICLOUD_REQ_BASE_URL=https://projectman-ext.cn-north-4.myhuaweicloud.com
# Optional live-smoke inputs for Req:
# HUAWEICLOUD_REQ_LIVE_PROJECT_IDS=project-id-1,project-id-2
# HUAWEICLOUD_REQ_LIVE_WRITE_PROJECT_ID=project-id
# Optional high-risk Req live-smoke gates:
# HUAWEICLOUD_REQ_LIVE_ENABLE_PROJECT_MUTATIONS=false
# HUAWEICLOUD_REQ_LIVE_ENABLE_ITERATION_MUTATIONS=false
# HUAWEICLOUD_REQ_LIVE_ENABLE_COMMENT_MUTATIONS=false
# HUAWEICLOUD_REQ_LIVE_WORK_ITEM_PROJECT_ID=project-id
# HUAWEICLOUD_REQ_LIVE_WORK_ITEM_ID=work-item-id
# HUAWEICLOUD_REQ_LIVE_IPD_CATEGORIES=FE,IR
# HUAWEICLOUD_REPO_BASE_URL=https://codehub-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_PIPELINE_BASE_URL=https://cloudpipeline-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_CHECK_BASE_URL=https://codearts-check.cn-north-4.myhuaweicloud.com
# Optional live-smoke inputs for Check:
# HUAWEICLOUD_CHECK_LIVE_PROJECT_ID=project-id
# HUAWEICLOUD_CHECK_LIVE_TASK_ID=task-id
# HUAWEICLOUD_TESTPLAN_BASE_URL=https://cloudtest-ext.cn-north-4.myhuaweicloud.com
# Optional live-smoke inputs for TestPlan:
# HUAWEICLOUD_TESTPLAN_LIVE_PROJECT_IDS=project-id-1,project-id-2
# HUAWEICLOUD_TESTPLAN_LIVE_PLAN_ID=plan-id
# HUAWEICLOUD_DEPLOY_BASE_URL=https://codearts-deploy.cn-north-4.myhuaweicloud.com
# Optional live-smoke inputs for Deploy:
# HUAWEICLOUD_DEPLOY_LIVE_PROJECT_ID=project-id
# HUAWEICLOUD_DEPLOY_LIVE_APPLICATION_ID=application-id
# HUAWEICLOUD_DEPLOY_LIVE_TASK_ID=task-id
# HUAWEICLOUD_DEPLOY_LIVE_RECORD_ID=record-id
# HUAWEICLOUD_DEPLOY_LIVE_TEMPLATE_PROBE_TEMPLATE_ID=template-id
# HUAWEICLOUD_DEPLOY_LIVE_TEMPLATE_PROBE_HOST_GROUP_ID=host-group-id
# Optional explicit execute probes for Deploy:
# HUAWEICLOUD_DEPLOY_LIVE_START_EXECUTE_TASK_ID=task-id
# HUAWEICLOUD_DEPLOY_LIVE_START_EXECUTE_HOST_GROUP=host-group-id
# HUAWEICLOUD_DEPLOY_LIVE_START_EXECUTE_PACKAGE_URL=/artifact/path/package.tgz
# HUAWEICLOUD_DEPLOY_LIVE_START_EXECUTE_SERVICE_PORT=3000
# HUAWEICLOUD_DEPLOY_LIVE_STOP_EXECUTE_TASK_ID=task-id
# HUAWEICLOUD_DEPLOY_LIVE_STOP_EXECUTE_HOST_GROUP=host-group-id
# HUAWEICLOUD_DEPLOY_LIVE_STOP_EXECUTE_PACKAGE_URL=/artifact/path/package.tgz
# HUAWEICLOUD_DEPLOY_LIVE_STOP_EXECUTE_SERVICE_PORT=3000
# HUAWEICLOUD_DEPLOY_LIVE_ROLLBACK_TASK_ID=task-id
# HUAWEICLOUD_DEPLOY_LIVE_ROLLBACK_RECORD_ID=record-id
# HUAWEICLOUD_BUILD_BASE_URL=https://cloudbuild-ext.cn-north-4.myhuaweicloud.com
# Optional live-smoke inputs for Build:
# HUAWEICLOUD_BUILD_LIVE_PROJECT_ID=project-id
# HUAWEICLOUD_BUILD_LIVE_JOB_ID=job-id
# HUAWEICLOUD_BUILD_LIVE_BUILD_PROJECT_ID=build-project-id
# HUAWEICLOUD_BUILD_LIVE_RECORD_ID=record-id
# HUAWEICLOUD_BUILD_LIVE_INFO_BUILD_NO=2
# HUAWEICLOUD_BUILD_LIVE_HISTORY_BUILD_NO=4
# HUAWEICLOUD_BUILD_LIVE_STOP_BUILD_NO=5
# HUAWEICLOUD_BUILD_LIVE_PROBE_RECORD_ID=00000000-0000-0000-0000-000000000000
# HUAWEICLOUD_ARTIFACT_BASE_URL=https://artifact.cn-north-4.myhuaweicloud.cn
# Optional live-smoke inputs for Artifact:
# HUAWEICLOUD_ARTIFACT_LIVE_PROJECT_IDS=project-id-1,project-id-2
# HUAWEICLOUD_ARTIFACT_LIVE_TENANT_ID=your-account-id
# Artifact tenant_id is the Huawei Cloud Account ID / IAM domainId.
# If you don't know it, you can derive it from Req project members: listProjectMembers(...).members[].domain_id
# HUAWEICLOUD_ARTIFACT_LIVE_REPO_NAMES=libs-release,libs-snapshot,generic,docker,maven,npm

# Transport:
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=127.0.0.1
# Docker Compose or other shared cross-container deployments should set MCP_HTTP_HOST=0.0.0.0.
# If browser-based clients send an Origin header, list allowed origins here.
# MCP_HTTP_ALLOWED_ORIGINS=https://your-domain.example
MCP_SERVER_NAME=codearts-mcp
MCP_SERVER_VERSION=0.1.0

# HTTP write rate limits:
# Product writes are counted per action/session. Auth writes are counted per session.
# Defaults are 3000 requests per 60 seconds.
# MCP_PRODUCT_WRITE_RATE_LIMIT_MAX_REQUESTS=3000
# MCP_PRODUCT_WRITE_RATE_LIMIT_WINDOW_MS=60000
# MCP_AUTH_WRITE_RATE_LIMIT_MAX_REQUESTS=3000
# MCP_AUTH_WRITE_RATE_LIMIT_WINDOW_MS=60000

# Shared HTTP auth persistence:
# Required in MCP_TRANSPORT=http mode.
# Use a long random secret and keep it stable across restarts.
# MCP_AUTH_MASTER_KEY=replace-with-a-long-random-secret
# Persist this on durable storage when running the shared HTTP server.
# MCP_AUTH_DATA_PATH=.codearts-mcp/auth-store.json
# Optional:
# MCP_AUTH_COOKIE_NAME=codearts_mcp_auth
# Set to true when your public endpoint is HTTPS.
# MCP_AUTH_COOKIE_SECURE=false
# Default is 30 days.
# MCP_AUTH_TOKEN_TTL_SECONDS=2592000
# Optional single-account mode for MCP clients that support static headers.
# The client config should send: Authorization: Bearer <MCP_AUTH_STATIC_TOKEN>
# HUAWEICLOUD_AK=your-ak
# HUAWEICLOUD_SK=your-sk
# HUAWEICLOUD_REGION=cn-north-4
# MCP_AUTH_STATIC_TOKEN=replace-with-a-long-random-token
# Optional shared-service mode: users provide their own credentials in MCP headers.
# HTTPS is required; keep this disabled on plain HTTP deployments.
# MCP_AUTH_ALLOW_CLIENT_CREDENTIAL_HEADERS=false
# Disabled by default because URL query tokens are commonly logged by proxies.
# Only enable for legacy clients that cannot send Authorization headers or retain cookies.
# MCP_AUTH_ALLOW_QUERY_TOKEN=false
