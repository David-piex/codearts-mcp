# Shared HTTP deployment template
#
# Copy this file to `.env` at the repository root when deploying the shared HTTP server.
# In shared mode, do NOT preconfigure one shared Huawei Cloud business account here.
# Each user connects to `/mcp` and calls `auth_configure_session` with their own AK/SK.

MCP_TRANSPORT=http
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0
# Set this when browser clients call /mcp and send an Origin header.
# MCP_HTTP_ALLOWED_ORIGINS=https://your-domain.example
MCP_SERVER_NAME=codearts-mcp
MCP_SERVER_VERSION=0.1.0

# Required for shared HTTP auth persistence.
MCP_AUTH_MASTER_KEY=replace-with-a-long-random-secret
MCP_AUTH_DATA_PATH=/app/.codearts-mcp/auth-store.json

# Optional.
MCP_AUTH_COOKIE_NAME=codearts_mcp_auth
MCP_AUTH_COOKIE_SECURE=false
MCP_AUTH_TOKEN_TTL_SECONDS=2592000

# Only override these when your tenant really uses non-standard product routes.
# HUAWEICLOUD_REQ_BASE_URL=https://projectman-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_REPO_BASE_URL=https://codehub-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_PIPELINE_BASE_URL=https://cloudpipeline-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_CHECK_BASE_URL=https://codecheck-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_TESTPLAN_BASE_URL=https://cloudtest-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_DEPLOY_BASE_URL=https://codearts-deploy.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_BUILD_BASE_URL=https://cloudbuild-ext.cn-north-4.myhuaweicloud.com
# HUAWEICLOUD_ARTIFACT_BASE_URL=https://artifact.cn-north-4.myhuaweicloud.cn
