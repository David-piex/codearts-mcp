{
  "name": "codearts-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codearts": "dist/src/server/cli.js",
    "codearts-mcp": "dist/src/server/cli.js"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:http": "tsx src/server/index.ts",
    "cli": "tsx src/server/cli.ts",
    "env:node": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-local-node.ps1",
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && tsc --noEmit && npm run tool-manifest:check && npm run function-api:check && npm run stats:check-docs && npm test && npm run build",
    "probe:edge": "tsx src/server/edge-probe.ts",
    "stats:modules": "tsx src/server/print-module-stats.ts",
    "req:coverage": "tsx src/server/print-req-coverage-audit.ts",
    "coverage:products": "tsx src/server/print-product-coverage-audit.ts",
    "stats:check-docs": "tsx src/server/check-module-stats-docs.ts",
    "stats:sync-docs": "tsx src/server/sync-module-stats-docs.ts",
    "tool-manifest:check": "tsx src/server/check-tool-manifest.ts",
    "function-api:check": "tsx src/server/check-function-api-reference.ts",
    "function-api:sync": "tsx src/server/sync-function-api-reference.ts",
    "test": "vitest run --no-isolate",
    "test:fast": "vitest run --no-isolate",
    "test:live": "vitest run --no-isolate --config vitest.live.config.ts",
    "test:isolate": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  }
}
